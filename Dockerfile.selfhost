# syntax=docker/dockerfile:1.7

# Self-contained multi-stage build for AFFiNE self-hosted deployment.
# Builds Rust native bindings, frontend assets, and server in Docker.
# Uses BuildKit cache mounts for Cargo, Yarn, and APT to speed up rebuilds.

# ---------------------------------------------------------------------------
# Stage 1: Install dependencies and build everything
# ---------------------------------------------------------------------------
FROM node:22-bookworm AS builder

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean && \
    apt-get update && apt-get install -y --no-install-recommends \
    curl build-essential clang pkg-config libssl-dev jq

# Install Rust toolchain
WORKDIR /app
COPY rust-toolchain.toml /app/rust-toolchain.toml
RUN RUST_TOOLCHAIN_VERSION=$(grep 'channel' rust-toolchain.toml | head -1 | awk -F '"' '{print $2}') && \
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y \
    --default-toolchain "${RUST_TOOLCHAIN_VERSION}" \
    --target x86_64-unknown-linux-gnu
ENV PATH="/root/.cargo/bin:${PATH}"
ENV CC="clang -D_BSD_SOURCE"
ENV TARGET_CC="clang -D_BSD_SOURCE"

COPY . /app

ENV HUSKY=0
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1
ENV SENTRYCLI_SKIP_DOWNLOAD=1
# Provide a dummy GITHUB_SHA so the HTML plugin skips git repo lookup
# (.git is excluded by .dockerignore).
ARG GITHUB_SHA="0000000000000000000000000000000000000000"
ENV GITHUB_SHA=${GITHUB_SHA}

# Install all dependencies (cache yarn's global download cache)
RUN --mount=type=cache,target=/root/.yarn/berry/cache \
    yarn --immutable --inline-builds

# Build Rust native binding (cache cargo registry + target dir).
RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/root/.cargo/git \
    --mount=type=cache,target=/app/target \
    yarn workspace @affine/server-native build --target x86_64-unknown-linux-gnu && \
    echo "=== Native binding files ===" && \
    ls -la packages/backend/native/server-native* && \
    file packages/backend/native/server-native.node

# Build frontend assets
RUN yarn affine @affine/web build
RUN yarn affine @affine/admin build
RUN yarn affine @affine/mobile build

# Build server — verify native binding is available for rspack bundling
RUN ls -la packages/backend/native/server-native* && \
    yarn workspace @affine/server build && \
    echo "=== Server dist contents ===" && \
    ls -la packages/backend/server/dist/

# Copy the native binding into dist/ so it's alongside main.js at runtime.
# rspack's node-loader emits it there during bundling, but as a fallback
# we also ensure it exists.
RUN cp packages/backend/native/server-native.node packages/backend/server/dist/server-native.node 2>/dev/null || true

# Re-install production-only deps for the final server package
RUN --mount=type=cache,target=/root/.yarn/berry/cache \
    yarn config set --json supportedArchitectures.cpu '["x64"]' && \
    yarn config set --json supportedArchitectures.libc '["glibc"]' && \
    yarn workspaces focus @affine/server --production

# Generate Prisma client
RUN yarn workspace @affine/server prisma generate

# Move node_modules into server package for the final image.
# Replace the @affine/server-native symlink with the actual files
# so the native binding resolves after the directory move.
RUN mv ./node_modules ./packages/backend/server/ && \
    rm -rf ./packages/backend/server/node_modules/@affine/server-native && \
    cp -r ./packages/backend/native ./packages/backend/server/node_modules/@affine/server-native

# ---------------------------------------------------------------------------
# Stage 2: Clean up artifacts
# ---------------------------------------------------------------------------
FROM node:22-bookworm-slim AS assets
WORKDIR /app

COPY --from=builder /app/packages/backend/server /app
COPY --from=builder /app/packages/frontend/apps/web/dist /app/static
COPY --from=builder /app/packages/frontend/admin/dist /app/static/admin
COPY --from=builder /app/packages/frontend/apps/mobile/dist /app/static/mobile

RUN apt-get update && \
    apt-get install -y --no-install-recommends openssl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN AFFINE_DOCKER_CLEAN=1 node ./scripts/docker-clean.mjs

# ---------------------------------------------------------------------------
# Stage 3: Final image
# ---------------------------------------------------------------------------
FROM node:22-bookworm-slim
WORKDIR /app

COPY --from=assets /app /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends openssl libjemalloc2 && \
    rm -rf /var/lib/apt/lists/*

RUN mkdir -p /home/node/.affine/config /home/node/.affine/storage && \
    chown -R node:node /home/node/.affine

# Verify native binding exists in final image
RUN ls -la /app/dist/server-native* 2>/dev/null; \
    ls -la /app/node_modules/@affine/server-native/server-native* 2>/dev/null; \
    echo "=== Final image ready ==="

ENV LD_PRELOAD=libjemalloc.so.2

USER node

EXPOSE 3010

CMD ["node", "./dist/main.js"]
