# ─────────────────────────────────────────────────────────────────────────────
# AION Environment Configuration
# Copy to .env and adjust:  cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Docker Compose ────────────────────────────────────────────────────────
AFFINE_REVISION=canary
PORT=3010
DB_USERNAME=affine
DB_PASSWORD=affine
DB_DATABASE=affine

# ── Claude / Agent Platform ──────────────────────────────────────────────
# Required for Agent Platform to function
ANTHROPIC_API_KEY=

# Model: sonnet, opus, haiku (empty = default)
# AGENT_MODEL=sonnet

# Agent user ID for @mention in comments (default: __aion_agent__)
# AGENT_USER_ID=__aion_agent__

# Path where the agent SQLite database will be stored
# AGENT_DB_PATH=/tmp/aion-agent

# Path on host where repos live (mounted as /repos in Docker)
REPOS_PATH=./repos

# ── Security ──────────────────────────────────────────────────────────────

# Comma-separated allowed repo paths/IDs (empty = all allowed)
# ALLOWED_REPOS=/repos/my-app,/repos/other-app

# Comma-separated allowed file path prefixes (empty = all, subject to denylists)
# ALLOWED_PATHS=src/,lib/,docs/

# Additional forbidden patterns (on top of built-in: .env, .pem, id_rsa, secrets, node_modules, dist, build)
# FORBIDDEN_PATHS=.github/workflows,infrastructure/

# Max total patch size in bytes (default: 1MB)
# MAX_PATCH_BYTES=1000000
