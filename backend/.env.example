# 12-factor config for Mosaic Server. Copy to .env for local runs.

NODE_ENV=development
HOST=0.0.0.0
PORT=3010
LOG_LEVEL=info

# Public URL the MIT client uses to reach this process.
MOSAIC_PUBLIC_URL=http://localhost:3010
MOSAIC_SERVER_NAME=Mosaic

# Wire-compat target for the MIT frontend (@affine/graphql / nbstore).
MOSAIC_COMPAT_VERSION=0.27.5

# Comma-separated feature flags shown on GET /info. Empty = none.
# GraphQL serverConfig.features always includes Comment (Phase 4) and Indexer (Phase 6).
# Payment / CopilotEmbedding are never advertised from this list.
# Copilot is advertised only when MOSAIC_AI_API_KEY is set (not from MOSAIC_FEATURES).
MOSAIC_FEATURES=

# Cutover flag. Client images bake MOSAIC_SERVER=1 at build time
# (BUILD_CONFIG.isMosaicServer). On this process it adds `mosaic` to GET /info.
MOSAIC_SERVER=

# Optional directory of MIT frontend assets (selfhost.html / index.html).
# Unset for API-only / tests. Production all-in-one image sets /app/static.
MOSAIC_STATIC_DIR=

# Persistence: omit DATABASE_URL or set MOSAIC_PERSISTENCE=memory for in-process store
# (required when Docker/Postgres is unavailable). postgres needs DATABASE_URL.
MOSAIC_PERSISTENCE=memory
DATABASE_URL=postgresql://mosaic:mosaic@127.0.0.1:5432/mosaic

# Redis 7 (optional). Phase 2 awareness/fanout is in-process; Redis adapter comes with multi-instance.
REDIS_URL=redis://127.0.0.1:6379

# Auth
MOSAIC_ALLOW_SIGNUP=true
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
SESSION_IDLE_MS=604800000
SESSION_ABSOLUTE_MS=2592000000
ACCESS_TOKEN_MS=900000
REFRESH_TOKEN_MS=2592000000
COOKIE_SECURE=false
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=20

# Doc sync (Phase 2). Compact merges append-only Yjs updates into a snapshot.
SYNC_COMPACT_UPDATES=64
SYNC_MAX_UPDATE_BYTES=1048576

# Blobs (Phase 3). memory = in-process (tests / no Docker); fs = local disk.
BLOB_DRIVER=memory
BLOB_DIR=data/blobs
BLOB_MAX_BYTES=104857600
BLOB_STORAGE_QUOTA_BYTES=107374182400
BLOB_MULTIPART_THRESHOLD=8388608
BLOB_PART_SIZE=5242880
BLOB_UPLOAD_TTL_MS=3600000
DOC_HISTORY_LIMIT=50

# Optional OpenTelemetry OTLP HTTP exporter. Empty = traces stay in-process.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=mosaic-server

# Phase 6 — OIDC (optional). When all three are set, serverConfig.oauthProviders includes OIDC/Google/GitHub/Apple.
MOSAIC_OIDC_ISSUER=
MOSAIC_OIDC_CLIENT_ID=
MOSAIC_OIDC_CLIENT_SECRET=
MOSAIC_OIDC_PROVIDER=OIDC

# Phase 6 — SAML (optional). Not advertised in oauthProviders.
MOSAIC_SAML_IDP_SSO_URL=
MOSAIC_SAML_IDP_ENTITY_ID=
MOSAIC_SAML_CERTIFICATE=

# Phase 6 — BYOK AI gateway (OpenAI-compatible). Unset = Copilot disabled.
MOSAIC_AI_BASE_URL=https://api.openai.com/v1
MOSAIC_AI_API_KEY=
MOSAIC_AI_MODEL=gpt-4o-mini

# Phase 6 — optional SIEM fan-out for audit events (failures are ignored).
MOSAIC_SIEM_WEBHOOK_URL=
AUDIT_RETENTION_DAYS=365

# Phase 6 — Jira REST v3 (optional). Inbound webhook uses MOSAIC_JIRA_WEBHOOK_SECRET.
MOSAIC_JIRA_BASE_URL=
MOSAIC_JIRA_EMAIL=
MOSAIC_JIRA_API_TOKEN=
MOSAIC_JIRA_WEBHOOK_SECRET=
