{
  "name": "@mosaic/server",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "description": "Clean-room Mosaic Server (Mosaic EE License, see LICENSE). Wire-compat with the MIT Mosaic/AFFiNE frontend.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
