# Stage 1: Build the AFFiNE web client
FROM node:18-alpine AS builder

WORKDIR /app

# Enable Yarn
RUN corepack enable

# Copy only manifest files first to leverage Docker layer caching
COPY package.json yarn.lock ./  
COPY workspaces.json ./  

# Install dependencies
RUN yarn install --immutable --network-timeout 100000

# Copy the rest of the source code
COPY . .

# Build the web client
RUN yarn workspace @affine/web build

# Stage 2: Use NGINX to serve the static files
FROM nginx:alpine

# Copy the built web client output
COPY --from=builder /app/packages/web/dist /usr/share/nginx/html

# Replace the default NGINX config to support SPA routing
COPY nginx-web-client.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
