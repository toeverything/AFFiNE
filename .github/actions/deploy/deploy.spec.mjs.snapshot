    [
      "upgrade",
      "--install",
      "affine",
      ".github/helm/affine",
      "--namespace",
      "beta",
      "--values",
      "<values.json>",
      "--timeout",
      "10m",
      "--atomic"
    ]
  ],
  "values": {
    "global": {
      "serverConfig": {
        "deployment": {
          "type": "cloud"
        },
        "db": {
          "datasourceUrl": "postgresql://user:p%40ss@sql-proxy:5432/affine"
        },
        "redis": {
          "host": "redis",
          "password": "comma,quote\\"dollar$backtick\`"
        },
        "crypto": {
          "privateKey": "test-key\\nsecond-line"
        },
        "server": {
          "host": "affine.example",
          "hosts": [
            "affine.example",
            "alias.example"
          ],
          "https": true,
          "path": ""
        },
        "indexer": {
          "provider": {
            "type": "elasticsearch",
            "endpoint": "https://search.example",
            "apiKey": "test-key"
          }
        },
        "payment": {
          "stripe": {
            "accountId": "acct_test",
            "environment": "test"
          }
        }
      },
      "app": {
        "buildType": "beta"
      },
      "version": "0.27.5-beta.2",
      "database": {
        "gcloud": {
          "enabled": true
        },
        "host": "sql-proxy",
        "port": "5432"
      },
      "ingress": {
        "enabled": true,
        "hosts": [
          "affine.example",
          "alias.example"
        ],
        "annotations": {
          "kubernetes.io/ingress.class": "gce",
          "kubernetes.io/ingress.allow-http": "true",
          "kubernetes.io/ingress.global-static-ip-name": "affine-ip"
        }
      }
    },
    "front": {
      "image": {
        "tag": "beta-abcdef"
      },
      "replicaCount": 1,
      "serviceAccount": {
        "annotations": {
          "iam.gke.io/gcp-service-account": "app@project.iam.gserviceaccount.com"
        }
      },
      "nodeSelector": {
        "cloud.google.com/gke-spot": "true"
      },
      "resources": {
        "requests": {
          "cpu": "1",
          "memory": "2Gi"
        }
      },
      "services": {
        "web": {
          "annotations": {
            "cloud.google.com/neg": "{\\"ingress\\": true}"
          }
        },
        "sync": {
          "annotations": {
            "cloud.google.com/neg": "{\\"ingress\\": true}"
          }
        },
        "renderer": {
          "annotations": {
            "cloud.google.com/neg": "{\\"ingress\\": true}"
          }
        }
      }
    },
    "graphql": {
      "image": {
        "tag": "beta-abcdef"
      },
      "replicaCount": 1,
      "serviceAccount": {
        "annotations": {
          "iam.gke.io/gcp-service-account": "app@project.iam.gserviceaccount.com"
        }
      },
      "nodeSelector": {
        "cloud.google.com/gke-spot": "true"
      },
      "resources": {
        "requests": {
          "cpu": "1",
          "memory": "1Gi"
        }
      },
      "service": {
        "annotations": {
          "cloud.google.com/neg": "{\\"ingress\\": true}"
        }
      }
    },
    "worker": {
      "image": {
        "tag": "beta-abcdef"
      }
    },
    "cloud-sql-proxy": {
      "database": {
        "connectionName": "project:region:database"
      },
      "serviceAccount": {
        "annotations": {
          "iam.gke.io/gcp-service-account": "sql@project.iam.gserviceaccount.com"
        }
      },
      "nodeSelector": {
        "iam.gke.io/gke-metadata-server-enabled": "true",
        "cloud.google.com/gke-spot": "true"
      }
    }
  }
}
