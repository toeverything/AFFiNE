      image: busybox
      command: ['wget']
      args: ['affine-graphql:3000']
  restartPolicy: Never

---
# Source: affine/charts/graphql/templates/migration.yaml
apiVersion: batch/v1
kind: Job
metadata:
  name: affine-graphql-database-migration
  labels:
    helm.sh/chart: graphql-0.0.0
    app.kubernetes.io/name: graphql
    app.kubernetes.io/instance: affine
    app.kubernetes.io/version: "0.27.5"
    app.kubernetes.io/managed-by: Helm
    monitoring: enabled
  annotations:
    "helm.sh/hook": post-install,pre-upgrade
    "helm.sh/hook-weight": "-1"
    "helm.sh/hook-delete-policy": before-hook-creation

spec:
  template:
    spec:
      serviceAccountName: affine-graphql
      initContainers:
      - name: wait-for-cloud-sql-proxy
        image: busybox:1.36.1
        imagePullPolicy: IfNotPresent
        command:
          - /bin/sh
          - -ec
          - |
            until wget -q -T 2 -O /dev/null "http://sql-proxy:9801/startup"; do
              echo "waiting for cloud sql proxy to become ready"
              sleep 2
            done
      containers:
      - name: graphql
        image: "ghcr.io/toeverything/affine:beta-abcdef"
        command: ["yarn", "predeploy"]
        env:
          # Prisma CLI still reads DATABASE_URL; derive it from the same config.
          - name: DATABASE_URL
            valueFrom:
              secretKeyRef:
                name: server-config
                key: database-url
          - name: NODE_ENV
            value: "production"
          - name: AFFINE_ENV
            value: "beta"
          - name: DEPLOYMENT_PLATFORM
            value: "gcp"
        volumeMounts:
          - name: server-config
            mountPath: /app/config.json
            subPath: graphql.json
            readOnly: true
        resources:
          requests:
            cpu: '100m'
            memory: '200Mi'
      volumes:
        - name: server-config
          secret:
            secretName: server-config
      restartPolicy: Never
  backoffLimit: 1


`;

