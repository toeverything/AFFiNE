# Source: affine/templates/ingress.yaml
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: affine
  labels:
    helm.sh/chart: affine-0.0.0
    app.kubernetes.io/name: affine
    app.kubernetes.io/instance: affine
    app.kubernetes.io/version: "0.27.5"
    app.kubernetes.io/managed-by: Helm
  annotations:
    kubernetes.io/ingress.allow-http: "true"
    kubernetes.io/ingress.class: gce
    kubernetes.io/ingress.global-static-ip-name: affine-ip
spec:
  rules:
    - host: "affine.example"
      http:
        paths:
          - path: /socket.io
            pathType: Prefix
            backend:
              service:
                name: affine-sync
                port:
                  number: 3010
          - path: /graphql
            pathType: Prefix
            backend:
              service:
                name: affine-graphql
                port:
                  number: 3000
          - path: /api
            pathType: Prefix
            backend:
              service:
                name: affine-graphql
                port:
                  number: 3000
          - path: /workspace
            pathType: Prefix
            backend:
              service:
                name: affine-renderer
                port:
                  number: 3000
          - path: /
            pathType: Prefix
            backend:
              service:
                name: affine-web
                port:
                  number: 8080
    - host: "alias.example"
      http:
        paths:
          - path: /socket.io
            pathType: Prefix
            backend:
              service:
                name: affine-sync
                port:
                  number: 3010
          - path: /graphql
            pathType: Prefix
            backend:
              service:
                name: affine-graphql
                port:
                  number: 3000
          - path: /api
            pathType: Prefix
            backend:
              service:
                name: affine-graphql
                port:
                  number: 3000
          - path: /workspace
            pathType: Prefix
            backend:
              service:
                name: affine-renderer
                port:
                  number: 3000
          - path: /
            pathType: Prefix
            backend:
              service:
                name: affine-web
                port:
                  number: 8080

