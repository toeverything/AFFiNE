apiVersion: v1
kind: Pod
metadata:
  name: "affine-graphql-test-connection"
  labels:
    helm.sh/chart: graphql-0.0.0
    app.kubernetes.io/name: graphql
    app.kubernetes.io/instance: affine
    app.kubernetes.io/version: "0.27.5"
    app.kubernetes.io/managed-by: Helm
    monitoring: enabled
  annotations:
    "helm.sh/hook": test
spec:
