# ─────────────────────────────────────────────────────────────────────────────
# AION Docker Compose Configuration
# Copy this file to .env and adjust values:  cp .env.docker .env
# ─────────────────────────────────────────────────────────────────────────────

# ── AFFiNE Image ──────────────────────────────────────────────────────────
# Which AFFiNE release to use: stable, beta, canary
AFFINE_REVISION=canary

# ── Ports ─────────────────────────────────────────────────────────────────
PORT=3010
DB_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# ── Database ──────────────────────────────────────────────────────────────
DB_USERNAME=affine
DB_PASSWORD=affine
DB_DATABASE=affine
DB_AUTH_METHOD=trust

# ── Agent Platform ────────────────────────────────────────────────────────
# Claude API key (required for Agent Platform)
ANTHROPIC_API_KEY=

# Model to use: sonnet, opus, haiku (leave empty for default)
AGENT_MODEL=

# Path on host where your repos live (mounted as /repos in container)
REPOS_PATH=./repos

# Security: comma-separated allowed repo paths (inside container)
ALLOWED_REPOS=
ALLOWED_PATHS=
FORBIDDEN_PATHS=
MAX_PATCH_BYTES=1000000
