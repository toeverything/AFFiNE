# syntax=docker/dockerfile:1.7
# Mosaic all-in-one production image: MIT frontend + clean-room Mosaic Server.
# The runtime filesystem MUST NOT contain packages/backend (AFFiNE EE).
#
#   docker compose build
#   docker build -f Dockerfile.from-source -t mosaic:local .

# --- MIT frontend. The yarn workspace still lists packages/backend; that is
# builder-only and is never copied into the runtime stage. ---
FROM node:22.23.2-bookworm AS frontend

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    git \
    python3 \
  && rm -rf /var/lib/apt/lists/*

ENV HUSKY=0 \
    ELECTRON_SKIP_BINARY_DOWNLOAD=1 \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 \
    NODE_OPTIONS=--max-old-space-size=8192 \
    BUILD_TYPE=stable \
    DEPLOYMENT_TYPE=selfhosted \
    MOSAIC_SERVER=1 \
    PUBLIC_PATH=/

WORKDIR /app
COPY . .

RUN corepack enable \
  && node -e "const fs=require('fs'); const p=JSON.parse(fs.readFileSync('package.json','utf8')); p.scripts.postinstall='yarn affine init'; fs.writeFileSync('package.json', JSON.stringify(p,null,2));"

RUN --mount=type=cache,target=/root/.yarn/berry/cache \
    yarn install

ENV GITHUB_SHA=mosaic-local

RUN yarn affine @affine/web build \
    && test -f packages/frontend/apps/web/dist/index.html
RUN yarn affine @affine/admin build \
    && test -f packages/frontend/admin/dist/index.html
RUN yarn affine @affine/mobile build \
    && test -f packages/frontend/apps/mobile/dist/index.html

# --- Mosaic Server. Context is backend/ only; never packages/backend. ---
FROM node:22.23.2-bookworm AS backend
WORKDIR /app
COPY backend/package.json backend/package-lock.json ./
RUN npm ci
COPY backend/tsconfig.json ./
COPY backend/src ./src
RUN npm run build
RUN npm ci --omit=dev && npm cache clean --force

# --- Runtime: Mosaic dist + MIT static. No EE, no Prisma, no native .node. ---
FROM node:22.23.2-bookworm-slim
WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && addgroup --system mosaic \
  && adduser --system --ingroup mosaic mosaic \
  && mkdir -p /data/blobs /app/static \
  && chown -R mosaic:mosaic /data/blobs /app

COPY --from=backend --chown=mosaic:mosaic /app/node_modules ./node_modules
COPY --from=backend --chown=mosaic:mosaic /app/package.json ./package.json
COPY --from=backend --chown=mosaic:mosaic /app/dist ./dist
COPY --from=frontend --chown=mosaic:mosaic /app/packages/frontend/apps/web/dist ./static
COPY --from=frontend --chown=mosaic:mosaic /app/packages/frontend/admin/dist ./static/admin
COPY --from=frontend --chown=mosaic:mosaic /app/packages/frontend/apps/mobile/dist ./static/mobile

RUN test ! -d /app/packages/backend \
  && test ! -d /app/packages \
  && test ! -e /app/scripts/self-host-predeploy.js \
  && test ! -d /app/prisma \
  && test -f /app/dist/main.js \
  && (test -f /app/static/index.html || test -f /app/static/selfhost.html)

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=3010 \
    MOSAIC_SERVER=1 \
    MOSAIC_STATIC_DIR=/app/static \
    BLOB_DRIVER=fs \
    BLOB_DIR=/data/blobs

USER mosaic
EXPOSE 3010
HEALTHCHECK --interval=15s --timeout=5s --retries=20 --start-period=40s \
  CMD node -e "fetch('http://127.0.0.1:3010/info').then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/main.js"]
