# ─────────────────────────────────────────────────────────────────────────────
# AION — Production Environment Variables
# Copy to .env and fill in all required values:  cp .env.prod.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Image (optional) ────────────────────────────────────────────────────
# Tag from registry.digitalocean.com/everestsk/aion (default: latest)
AION_TAG=latest

# ── Domain (REQUIRED) ───────────────────────────────────────────────────
# Your domain pointing to this server (Caddy will auto-provision HTTPS)
DOMAIN=aion.example.com

# ── Database (REQUIRED) ────────────────────────────────────────────────
DB_USERNAME=affine
DB_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD
DB_DATABASE=affine

# ── Agent Platform (REQUIRED) ──────────────────────────────────────────
# Anthropic API key for Claude Code
ANTHROPIC_API_KEY=sk-ant-...

# Model: sonnet, opus, haiku (leave empty for default)
AGENT_MODEL=

# Path on host where repos live (mounted as /repos in container)
REPOS_PATH=./repos

# ── Google OAuth ──────────────────────────────────────────────────────
# Configure in config/config.json (NOT here), see docs/deploy.md

# ── Mail (optional — needed for invite emails) ─────────────────────────
# MAILER_HOST=smtp.gmail.com
# MAILER_PORT=587
# MAILER_SENDER=noreply@example.com
# MAILER_USER=noreply@example.com
# MAILER_PASSWORD=
# MAILER_SECURE=true

# ── Security (optional) ────────────────────────────────────────────────
ALLOWED_REPOS=
ALLOWED_PATHS=
FORBIDDEN_PATHS=
MAX_PATCH_BYTES=1000000
