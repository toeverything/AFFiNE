{
  "left_target": {
    "base_url": "http://127.0.0.1:1"
  },
  "right_target": {
    "base_url": "http://127.0.0.1:2"
  },
  "timeout_ms": 20000,
  "expected_smtp_count": 1,
  "dynamic": [
    {
      "path": "/(id|userId|workspaceId|spaceId|docId|clientId|sessionId|requestId|originId|sid|workspace_id|user_id|session_id|principal_id|[a-z_]+_by)$",
      "kind": "id"
    },
    {
      "path": "/body/value/data/appConfig/(server|redis|mailer/SMTP)/port$",
      "kind": "id"
    },
    {
      "path": "/[A-Za-z_]*(At|_at|_ts)$|^/protocol/.*/attributes/expires$|/timestamp$",
      "kind": "ts"
    },
    {
      "path": "/headers/set-cookie/[0-9]+/value$|^/database/public\\.users/[0-9]+/password$|^/database/public\\.app_configs/.*/secret$",
      "kind": "token"
    }
  ],
  "steps": [
    {
      "name": "info",
      "kind": "http",
      "method": "GET",
      "path": "/info"
    },
    {
      "name": "server_config_before_setup",
      "kind": "graphql",
      "query": "query { serverConfig { version name type initialized baseUrl features credentialsRequirement { password { minLength maxLength } } } }"
    },
    {
      "name": "create_admin_user",
      "kind": "http",
      "method": "POST",
      "path": "/api/setup/create-admin-user",
      "body": {
        "name": "Parity Admin",
        "email": "parity-admin@affine.test",
        "password": "Parity-Admin-Passw0rd"
      }
    },
    {
      "name": "session",
      "kind": "http",
      "method": "GET",
      "path": "/api/auth/session"
    },
    {
      "name": "current_user",
      "kind": "graphql",
      "query": "query { currentUser { id name email emailVerified hasPassword features quota { name blobLimit storageQuota historyPeriod memberLimit humanReadable { name blobLimit storageQuota historyPeriod memberLimit } } } }"
    },
    {
      "name": "create_workspace",
      "kind": "graphql",
      "query": "mutation { createWorkspace { id public } }",
      "extract": {
        "workspace": "/body/value/data/createWorkspace/id"
      }
    },
    {
      "name": "workspace_quota",
      "kind": "graphql",
      "query": "query ($id: String!) { workspace(id: $id) { id public quota { name blobLimit storageQuota usedStorageQuota historyPeriod memberLimit memberCount overcapacityMemberCount humanReadable { name blobLimit storageQuota historyPeriod memberLimit } } } }",
      "variables": {
        "id": "{{workspace}}"
      }
    },
    {
      "name": "doc_sync",
      "kind": "socketio",
      "actions": [
        {
          "action": "emit_with_ack",
          "event": "space:join-batch",
          "args": [
            {
              "spaces": [
                {
                  "spaceType": "workspace",
                  "spaceId": "{{workspace}}",
                  "docId": "{{workspace}}"
                }
              ],
              "clientVersion": "0.27.5",
              "protocolVersion": 2
            }
          ]
        },
        {
          "action": "emit_with_ack",
          "event": "space:push-doc-update",
          "args": [
            {
              "spaceType": "workspace",
              "spaceId": "{{workspace}}",
              "docId": "parity-self-doc",
              "update": "AQIBACgBBG1ldGEFdGl0bGUBdwZwYXJpdHkEAQdjb250ZW50DGhlbGxvIHBhcml0eQA=",
              "intent": "create"
            }
          ]
        },
        {
          "action": "emit_with_ack",
          "event": "space:join-batch",
          "args": [
            {
              "spaces": [
                {
                  "spaceType": "workspace",
                  "spaceId": "{{workspace}}",
                  "docId": "parity-self-doc"
                }
              ],
              "clientVersion": "0.27.5",
              "protocolVersion": 2
            }
          ]
        },
        {
          "action": "emit_with_ack",
          "event": "space:load-doc",
          "args": [
            {
              "spaceType": "workspace",
              "spaceId": "{{workspace}}",
              "docId": "parity-self-doc"
            }
          ]
        }
      ],
      "record_events": []
    },
    {
      "name": "app_config",
      "kind": "graphql",
      "query": "query { appConfig }",
      "extract": {
        "smtp": "/body/value/data/appConfig/mailer/SMTP"
      }
    },
    {
      "name": "send_test_email",
      "kind": "graphql",
      "query": "mutation ($config: JSONObject!) { sendTestEmail(config: $config) }",
      "variables": {
        "config": "{{smtp}}"
      }
    }
  ],
  "require": [
    {
      "path": "/protocol/0/status",
      "equals": 200
    },
    {
      "path": "/protocol/2/status",
      "equals": 201
    },
    {
      "path": "/protocol/4/body/value/data/currentUser/email",
      "equals": "parity-admin@affine.test"
    },
    {
      "path": "/protocol/7/body/value/acks/0/value/data/success",
      "equals": true
    },
    {
      "path": "/protocol/7/body/value/acks/1/value/data/accepted",
      "equals": true
    },
    {
      "path": "/protocol/7/body/value/acks/3/value/data/missing",
      "equals": "AQIBACgBBG1ldGEFdGl0bGUBdwZwYXJpdHkEAQdjb250ZW50DGhlbGxvIHBhcml0eQA="
    },
    {
      "path": "/protocol/9/body/value/data/sendTestEmail",
      "equals": true
    },
    {
      "path": "/database/public.updates",
      "contains": {
        "guid": "parity-self-doc"
      }
    },
    {
      "path": "/database/public.storage_reconciliation_checkpoints",
      "contains": {
        "kind": "schema_baseline_0275"
      }
    },
    {
      "path": "/effects/smtp",
      "length": 1
    },
    {
      "path": "/effects/redis",
      "contains": {
        "channel": "affine:backend-runtime:invalidation:v1"
      }
    },
    {
      "path": "/effects/redis",
      "contains": {
        "channel": "affine:eventbus:v1",
        "payload": {
          "value": {
            "event": "sync.doc.updates.pushed"
          }
        }
      }
    }
  ]
}
